{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bayzip",
  "version": "1.1.5",
  "identifier": "com.baymax.bayzip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bayzip",
        "width": 800,
        "height": 700,
        "decorations": false,
        "transparent": false,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "Bayzip Settings",
        "url": "index.html?window=settings",
        "width": 580,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["bay"],
        "name": "Bayzip Archive",
        "description": "Bayzip Compressed Archive",
        "role": "Viewer"
      },
      {
        "ext": ["bayg"],
        "name": "Bayzip Gamer Mod Pack",
        "description": "Bayzip Gamer Compressed Archive",
        "role": "Viewer"
      }
    ]
  }
}
