{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bayzip",
  "version": "2.4.7",
  "identifier": "com.baymax.bayzip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bayzip",
        "width": 800,
        "height": 700,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Bayzip Settings",
        "url": "index.html?window=settings",
        "width": 580,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "progress",
        "title": "Bayzip Progress",
        "url": "index.html?window=progress",
        "width": 480,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      },
      {
        "label": "mini-extract",
        "title": "Bayzip Extract",
        "url": "index.html?window=mini-extract",
        "width": 480,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "uninstallerHeaderImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    },
    "fileAssociations": [
      {
        "ext": ["bay"],
        "name": "Bayzip Archive",
        "description": "Bayzip Compressed Archive",
        "role": "Viewer"
      },
      {
        "ext": ["bayg"],
        "name": "Bayzip Gamer Mod Pack",
        "description": "Bayzip Gamer Compressed Archive",
        "role": "Viewer"
      },
      {
        "ext": ["zip"],
        "name": "ZIP Archive",
        "description": "Compressed ZIP Archive",
        "role": "Viewer"
      },
      {
        "ext": ["7z"],
        "name": "7-Zip Archive",
        "description": "7-Zip Compressed Archive",
        "role": "Viewer"
      },
      {
        "ext": ["tar"],
        "name": "TAR Archive",
        "description": "TAR Tape Archive",
        "role": "Viewer"
      },
      {
        "ext": ["rar"],
        "name": "RAR Archive",
        "description": "WinRAR Compressed Archive",
        "role": "Viewer"
      }
    ]
  }
}
